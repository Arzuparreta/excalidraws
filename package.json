{
  "name": "excalidraws",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run build:editor && concurrently -k \"node scripts/dev-server.mjs\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/main.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run build:editor && npm run test:e2e",
    "build:editor": "node scripts/build-editor.mjs",
    "package:shell": "npm run build && node scripts/package-shell.mjs"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "nanoid@<4": "3.3.18",
    "nanoid@>=4": "5.1.16",
    "katex": "0.18.2"
  },
  "dependencies": {
    "express": "5.3.0",
    "idb-keyval": "6.3.0",
    "lucide-solid": "1.68.0",
    "solid-js": "1.9.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15",
    "@excalidraw/excalidraw": "0.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
